# ============================================================
# SIAE — Frontend PWA: Variables de Entorno PRODUCCIÓN
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo como `.env.production.local`
#   2. Reemplaza TODOS los valores con tus secretos reales
#   3. NUNCA subas este archivo con secretos al repositorio
#   4. En CI/CD, inyecta estas variables como secrets cifrados
# ============================================================

# ── API Pública (accesible desde el navegador) ───────────────
# URL base del gateway HTTP del backend SIAE
NEXT_PUBLIC_API_URL=https://api.siae.gob.ve

# URL base para conexiones WebSocket (sala de emergencia, RTT)
NEXT_PUBLIC_WS_URL=wss://api.siae.gob.ve

# URL del servidor LiveKit SFU para videollamadas WebRTC
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.siae.gob.ve

# Clave pública VAPID para Web Push Notifications
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_KEY=REEMPLAZAR_CON_CLAVE_PUBLICA_VAPID_REAL

# ── Variables del Servidor BFF (Next.js Route Handlers) ──────
# URL interna del backend Go (accesible solo desde el servidor)
# En Kubernetes/Docker: usar nombre de servicio interno
BACKEND_API_URL=http://siae-backend:8080

# ── Configuración del entorno ─────────────────────────────────
NODE_ENV=production
